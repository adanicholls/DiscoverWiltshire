# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Supabase project settings — Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only - never expose to the browser (no NEXT_PUBLIC_ prefix).
# Used by the admin area (approve/decline/edit listings).
SUPABASE_SERVICE_ROLE_KEY=
# The only email allowed into /admin, checked against the logged-in
# Supabase Auth user - create that user in the Supabase dashboard
# (Authentication -> Users), not through a public sign-up form.
ADMIN_EMAIL=

# Added later, once payments are wired up.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
